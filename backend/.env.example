# Copy to backend/.env and adjust. Only MONGO_URL and JWT_SECRET matter for local development.

ENV=development                       # set to "production" to enforce a real JWT_SECRET
MONGO_URL=mongodb://localhost:27017
DB_NAME=Enterprise-Management-System

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRY_DAYS=7

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# When false, only admins can add people (User Management → Add user).
# The first account ever created is always allowed and becomes the admin.
ALLOW_OPEN_REGISTRATION=true

# Optional: AI assistant (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: email notifications for task assignments (https://resend.com)
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# Optional
UPLOAD_DIR=                           # defaults to backend/uploads
MAX_UPLOAD_MB=20
DEADLINE_SCAN_MINUTES=30

# Google sign-in through Emergent Auth only works when hosted on the Emergent platform
EMERGENT_AUTH_ENABLED=false
