# Copy to backend/.env for local development. Every value has a sensible dev default.

ENV=development
DATABASE_URL=postgresql+asyncpg://pm:pm@localhost:5432/pm

# Required in production (>= 32 random chars): python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Serve over HTTPS in production and set COOKIE_SECURE=true. Use COOKIE_SAMESITE=none only when the
# web app and API live on different sites (requires COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Browser origins allowed to call the API, and the public URL of the web app (for invitation links)
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# false = invite-only (the very first account can always sign up)
ALLOW_SIGNUP=true

UPLOAD_DIR=
MAX_UPLOAD_MB=25
REMINDER_INTERVAL_MINUTES=30
